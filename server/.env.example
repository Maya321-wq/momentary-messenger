PORT=5000
NODE_ENV=development

# Firebase Admin
# FIREBASE_SERVICE_ACCOUNT_PATH is automatically resolved to server/serviceAccountKey.json

# MongoDB (optional)
MONGO_URI=

# Redis (optional)
REDIS_URL=
REDIS_TTL_SECONDS=120

# Twilio MFA (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MFA_PHONE_NUMBER=

# CORS
CLIENT_URL=http://localhost:3000
